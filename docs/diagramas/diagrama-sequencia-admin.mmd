sequenceDiagram
    autonumber
    actor Admin as Usuario administrador
    participant Painel as Painel administrativo
    participant Atendimento as Plataforma
    participant Cardapio as Cardapio

    Admin->>Painel: Abre o painel administrativo
    Painel->>Atendimento: Solicita os dados atuais do cardapio
    Atendimento->>Cardapio: Busca os itens
    Cardapio-->>Atendimento: Retorna o cardapio atual

    alt Dados carregados com sucesso
        Atendimento-->>Painel: Exibe lista de itens e formulario de edicao
    else Falha no carregamento
        Atendimento-->>Painel: Exibe mensagem de erro
    end

    opt Admin cria ou edita um item
        Admin->>Painel: Preenche ou altera os dados do prato
        Admin->>Painel: Salva o item
        Painel->>Atendimento: Valida os dados informados
        alt Dados validos
            Atendimento-->>Painel: Atualiza a lista de itens
        else Dados invalidos
            Atendimento-->>Painel: Informa os campos com erro
        end
    end

    opt Admin remove um item
        Admin->>Painel: Solicita remocao
        Painel->>Atendimento: Remove o item
        Atendimento-->>Painel: Atualiza a lista de itens
    end

    opt Admin importa ou exporta o cardapio
        Admin->>Painel: Escolhe importar um arquivo
        Painel->>Atendimento: Importa ou gera o cardapio
        Atendimento-->>Painel: Exibe o resultado da acao
    end
